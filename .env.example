# Copy to .env for local (non-Docker) runs. All values are optional; defaults are shown.
DATABASE_URL=sqlite+aiosqlite:///./data/summarizer.db
CELERY_BROKER_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
LLM_TIMEOUT_SECONDS=120
SUMMARY_CHAR_LIMIT=1500
MAX_CHARS_PER_CHUNK=6000
TASK_MAX_RETRIES=3
# Set to true only to summarize pages on localhost/private networks during development.
ALLOW_PRIVATE_URLS=false
